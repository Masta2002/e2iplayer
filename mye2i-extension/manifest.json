{
  "name": "MyE2iV3",
  "version": "1.17.5",
  "description": "E2iPlayer helper extension for solving captchas (Cloudflare managed-challenge detection fixes, see README.md)",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "cookies",
    "contextMenus",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
        "js": ["contentscripts/rc2ContentscriptProxy.js"],
        "run_at": "document_start",
        "all_frames": false,
        "matches": ["<all_urls>"],
        "include_globs": ["*#e2it*"]
    },
    {
      "js": ["contentscripts/e2it.js"],
      "run_at": "document_start",
      "all_frames": false,
      "matches": ["http://*/e2it.html"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["res/browser_solver_template.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "default_locale": "en"
}
